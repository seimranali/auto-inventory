<?xml version="1.0" encoding="utf-8"?>
<!-- /api application: IIS starts and supervises the Next.js server through HttpPlatformHandler. -->
<configuration>
  <system.webServer>
    <!-- Don't inherit the site's SPA rewrite -->
    <rewrite>
      <rules>
        <clear />
      </rules>
    </rewrite>
    <!-- WebDAV answers PUT / DELETE itself with 405 (save / delete fail): take it out of the pipeline -->
    <modules runAllManagedModulesForAllRequests="false">
      <remove name="WebDAVModule" />
    </modules>
    <handlers>
      <remove name="WebDAV" />
      <remove name="ExtensionlessUrlHandler-Integrated-4.0" />
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>
    <httpPlatform processPath="node.exe" arguments=".\server.js"
                  startupTimeLimit="60" startupRetryCount="3"
                  stdoutLogEnabled="true" stdoutLogFile=".\logs\node"
                  forwardWindowsAuthToken="false">
      <environmentVariables>
        <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />
        <environmentVariable name="HOSTNAME" value="127.0.0.1" />
        <environmentVariable name="NODE_ENV" value="production" />
        <!-- Database and uploads: set these, or put them in .env.production next to server.js -->
        <!--
        <environmentVariable name="MSSQL_SERVER" value="localhost" />
        <environmentVariable name="MSSQL_DATABASE" value="AutoInventory" />
        <environmentVariable name="MSSQL_USER" value="autoinventory" />
        <environmentVariable name="MSSQL_PASSWORD" value="change-me" />
        <environmentVariable name="DATA_DIR" value="D:\AutoInventoryData" />
        -->
      </environmentVariables>
    </httpPlatform>
    <security>
      <requestFiltering>
        <!-- photos and auction-sheet PDFs: 50 MB per request -->
        <requestLimits maxAllowedContentLength="52428800" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
