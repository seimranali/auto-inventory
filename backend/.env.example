# Copy to .env.local (development) or set these in the service environment (production)
MSSQL_SERVER=localhost
MSSQL_PORT=1433
MSSQL_DATABASE=AutoInventory
MSSQL_USER=sa
MSSQL_PASSWORD=change-me
# true for Azure SQL / TLS-required servers
MSSQL_ENCRYPT=false
# Folder for uploaded photos, auction sheets and the logo (default: data\ next to the app).
# In production keep it outside the deploy folder so redeploys never touch it.
# DATA_DIR=D:\AutoInventoryData
